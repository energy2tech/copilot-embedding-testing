{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.5.0/schema.json",
  "name": "fleet03",
  "position": {
    "x": 20,
    "y": 305,
    "z": 3,
    "height": 390,
    "width": 1240,
    "tabOrder": 3
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Site"
                    }
                  },
                  "Property": "Site Name"
                }
              },
              "queryRef": "Site.Site Name",
              "nativeQueryRef": "Site Name"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Daily Generation"
                    }
                  },
                  "Property": "Total Generation MWh"
                }
              },
              "queryRef": "Daily Generation.Total Generation MWh",
              "nativeQueryRef": "Total Generation MWh"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
